; Last-Space — Godot project configuration
; Engine: Godot 4.7.2, GDScript, gl_compatibility (WebGL 2.0)
config_version=5

[application]

config/name="Last-Space"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; Full landscape MOBILE-FIRST ANDROID (UI_UX_DESIGN.md §6, riset berbasis standar):
; root viewport ADAPTIF = ukuran window aktual (viewport_width/height=0 ->
; viewport = window, full screen TANPA letterbox; diverifikasi dari source Godot
; 4.7.2 scene/main/window.cpp:1328 — content_scale_size 0 => final_size = size).
; Resolusi DESAIN tetap 1280x720 (= 640x360dp @2x = screen referensi Android
; 360x640dp landscape 16:9) — dipakai sebagai design canvas HUD (hud.gd scale
; uniform match-height); kamera 3D mengikuti aspek window (lebih lebar = lebih
; banyak arena terlihat, UI tetap di posisi desain yang sama secara fisik).
window/size/viewport_width=0
window/size/viewport_height=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
TimeSystem="*res://scripts/core/time_system.gd"
GameData="*res://scripts/core/game_data.gd"
Economy="*res://scripts/core/economy.gd"
QaMarkers="*res://scripts/core/qa_markers.gd"
SeededRng="*res://scripts/core/seeded_rng.gd"
SaveSystem="*res://scripts/core/save_system.gd"
GameManager="*res://scripts/core/game_manager.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
; warna clear = dark space (letterbox 16:9 menyatu dengan loading screen)
environment/defaults/default_clear_color=Color(0.02, 0.027, 0.059, 1)
